# ─── Supabase ───────────────────────────────────────────────
# Copia estos valores desde: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo para operaciones server-side (no exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Verificación de ubicación (asistencia) ──────────────────
# IP pública del WiFi de ESAT. Para obtenerla: conéctate a esa
# red y entra a https://api.ipify.org desde el navegador.
# Sin esto, el registro de asistencia funciona igual con GPS solo.
AUTHORIZED_IP_1=
AUTHORIZED_IP_2=

# Pon esto en "true" para DESACTIVAR temporalmente la verificación de
# WiFi/GPS (útil mientras se prueban otras cosas sin estar en el campus).
# Vuelve a "false" (o bórralo) para exigirla de nuevo. Requiere redeploy
# porque es una variable NEXT_PUBLIC_ (se usa en el navegador).
NEXT_PUBLIC_SKIP_LOCATION_CHECK=false
